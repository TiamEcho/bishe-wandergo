# Dots Studio 大模型配置（不填也能跑，会自动降级为本地规则抽取）
# 注意：接口版本是 /v1（/v3 会 404）。/v1/models 可列出 dots3-note-prev
DOTS_API_BASE=https://note3-prev-api.askdiandian.com/v1
DOTS_MODEL=dots3-note-prev
DOTS_API_KEY=
# 若平台不是 OpenAI 兼容路径，可在这里改（默认 /chat/completions）
DOTS_CHAT_PATH=/chat/completions

# ---- MediaCrawler（独立部署在本机的 Python 项目）----
# 填 MediaCrawler 项目根目录的绝对路径（该目录下应有 main.py 与 config/base_config.py）
MEDIACRAWLER_PATH=
# Python 解释器（Windows 默认 python；虚拟环境可写绝对路径）
MEDIACRAWLER_PYTHON=python
# 采集平台：xhs（小红书）/ dy（抖音）/ ks（快手）/ wb（微博）等，取决于 MediaCrawler 支持
MEDIACRAWLER_PLATFORM=xhs
# 启动参数，留空则默认 "--platform ${MEDIACRAWLER_PLATFORM} --lt qrcode --type search"
MEDIACRAWLER_ARGS=
# 单次采集超时（毫秒），扫码登录+搜索一般需要 1~3 分钟
MEDIACRAWLER_TIMEOUT=300000
# 单次最多入库条数
MEDIACRAWLER_MAX_ITEMS=20

# 后端端口（前端 js/api.js 默认指向 8080）
PORT=8080
