# Dots Studio 大模型配置（不填也能跑，会自动降级为本地规则抽取）
# 注意：接口版本是 /v1（/v3 会 404）。/v1/models 可列出 dots3-note-prev
DOTS_API_BASE=https://note3-prev-api.askdiandian.com/v1
DOTS_MODEL=dots3-note-prev
DOTS_API_KEY=
# 若平台不是 OpenAI 兼容路径，可在这里改（默认 /chat/completions）
DOTS_CHAT_PATH=/chat/completions

# 后端端口（前端 js/api.js 默认指向 8080）
PORT=8080

# 高德 Web 服务 Key（注意是「Web 服务」不是「Web 端 JS API」）
# 用于：① 城市中心地理编码（扇形分区的锚点） ② 景点周边 500m 餐厅 / 住宿检索
# 不填也能跑：中心点退化为站内景点库均值，周边餐饮退化为本地美食库
AMAP_KEY=
# 高德请求超时（毫秒）
AMAP_TIMEOUT=6000
